# Copier ce fichier en .env (jamais commité) et remplir les SECRETS.
#
# Stratégie (héritée de HorRAGor2) :
# - Les SECRETS ci-dessous doivent être renseignés (pas de valeur par défaut dans le code).
# - Les autres réglages (URL de l'API, modèles, seuils...) ont déjà une valeur par défaut
#   dans src/config.py. Ne les ajoutez ICI que pour SURCHARGER un défaut (exemples
#   commentés plus bas). Inutile de tout recopier.

# ===== SECRETS (à remplir) =====
# La base SOURCE (Supabase) : lue par ./scripts/dump_supabase.sh pour alimenter
# la base du cluster, et par l'API en accès direct hors cluster (mode dev).
# En cluster, l'API Données reçoit sa propre URL (conteneur db) du compose.
# (Supabase > Project Settings > Database > Connection string > URI, en remplaçant
#  "postgresql://" par "postgresql+psycopg://").
DATABASE_URL=
# TMDB : token v4 (Bearer) pour enrichir réalisateur/casting (absents de la base).
TMDB_TOKEN=

# ===== Auth JWT (verrou IHM ↔ API IA, brief épilogue) =====
# Générer le secret : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Compte de démonstration (login du Front Streamlit).
APP_USERNAME=
APP_PASSWORD=

# ===== Langfuse (monitoring de l'agent) =====
# Hors cluster : vides = observabilité désactivée (fail-open).
# En cluster : Langfuse est intégré (monitoring/langfuse/) et ces deux clés
# sont PROVISIONNÉES au démarrage (init headless) — choisir librement deux
# valeurs au format pk-lf-<aléa> / sk-lf-<aléa>.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
# Secrets internes de la stack Langfuse (générer : secrets.token_hex(24) ;
# ENCRYPTION_KEY = exactement 64 caractères hexadécimaux, secrets.token_hex(32)).
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_PASSWORD=
# Compte admin créé au premier démarrage (UI http://localhost:3000).
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=

# ===== Observabilité du cluster =====
# Grafana http://localhost:3002 (compte admin) ; Uptime Kuma http://localhost:3001
# (compte créé par scripts/setup_uptime_kuma.py).
GRAFANA_ADMIN_PASSWORD=
KUMA_ADMIN_USER=
KUMA_ADMIN_PASSWORD=

# ===== Base du cluster (couche Données conteneurisée) =====
# Postgres + pgvector du réseau privé, restauré depuis Supabase par
# ./scripts/dump_supabase.sh (qui lit DATABASE_URL ci-dessus, ou
# SOURCE_DATABASE_URL si défini). Mot de passe URL-safe : générer avec
# python -c "import secrets; print(secrets.token_hex(24))"
# SOURCE_DATABASE_URL=
POSTGRES_USER=horragor
POSTGRES_PASSWORD=
# POSTGRES_DB=horragor
# Rôle en lecture seule utilisé par l'API Données (le superutilisateur
# ci-dessus ne quitte jamais le conteneur db).
# POSTGRES_RO_USER=horragor_ro
POSTGRES_RO_PASSWORD=

# ===== Cluster (épilogue MLOps) =====
# URL de l'API Données : définie dans le compose (http://api-donnees:8100),
# la couche IA ne parle alors plus jamais directement à la base.
# DATA_API_URL=

# IP de la passerelle Docker où le relais expose Ollama aux conteneurs
# (celle de host-gateway ; vérifier avec `ip -4 addr show docker0`).
# DOCKER_GATEWAY_IP=172.17.0.1

# ===== Surcharges optionnelles (décommenter au besoin) =====
# URL de l'API IA vue par le Front (le port d'écoute, lui, se choisit sur la
# ligne de commande : `uvicorn src.main:app --port 8000`).
# API_BASE_URL=http://127.0.0.1:8000
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen2.5:7b
# NARRATION_TEMPERATURE=0.7
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768
# TMDB_BASE_URL=https://api.themoviedb.org/3
# FAISS_INDEX_DIR=data/faiss_index
# FAISS_SCORE_THRESHOLD=0.75
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_HOURS=12
# LOG_LEVEL=INFO
